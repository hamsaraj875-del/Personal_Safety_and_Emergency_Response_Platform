<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

        <!-- Red Gradient Hero Section -->
        <FrameLayout
            android:id="@+id/hero_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_red_gradient"
            android:paddingStart="24dp"
            android:paddingTop="28dp"
            android:paddingEnd="24dp"
            android:paddingBottom="36dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Siren Icon -->
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_shield"
                        app:tint="@color/white_surface" />

                    <TextView
                        android:id="@+id/tv_active_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="ACTIVE EMERGENCY"
                        android:textColor="@color/soft_pink"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_demo_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_chip"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:paddingStart="8dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="2dp"
                        android:text="DEMO CONTROLS"
                        android:textColor="@color/primary_red"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Dynamic Status Heading -->
                <TextView
                    android:id="@+id/tv_status_heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:textColor="@color/white_surface"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    tools:text="@string/status_alerting_contacts" />

                <!-- Incident ID & Location sharing status -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_hero_incident_id"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:textColor="@color/light_rose"
                        android:textSize="13sp"
                        tools:text="Incident: #INC-2026-4821" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="•"
                        android:textColor="@color/light_rose" />

                    <TextView
                        android:id="@+id/tv_location_sharing_pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="@string/location_sharing_on"
                        android:textColor="@color/white_surface"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </FrameLayout>

        <!-- Escalation Countdown Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_countdown"
            style="@style/Widget.Jaagruth.Card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="-20dp"
            android:layout_marginEnd="16dp"
            app:cardElevation="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/hero_header">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_next_escalation_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:textColor="@color/heading"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="Next escalation in 00:08" />

                    <TextView
                        android:id="@+id/tv_current_step_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_chip"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:textColor="@color/primary_red"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Step 1/5" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_escalation"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="12dp"
                    android:max="10"
                    android:progress="8"
                    app:indicatorColor="@color/primary_red"
                    app:trackColor="@color/light_rose"
                    app:trackCornerRadius="4dp" />

                <TextView
                    android:id="@+id/tv_escalation_subtext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:textColor="@color/secondary_text"
                    android:textSize="12sp"
                    tools:text="Currently alerting Contact 1. Next: Contact 2" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Escalation Ladder Visual Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_ladder"
            style="@style/Widget.Jaagruth.Card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_countdown">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="@string/escalation_ladder_title"
                    android:textColor="@color/heading"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Ladder Steps Container -->
                <LinearLayout
                    android:id="@+id/layout_ladder_steps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Action Buttons -->
        <LinearLayout
            android:id="@+id/layout_action_buttons"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_ladder">

            <!-- See responders on map button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_see_map"
                style="@style/Widget.Jaagruth.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="@string/btn_see_map"
                app:icon="@drawable/ic_map"
                app:iconGravity="textStart"
                app:iconTint="@color/white_surface" />

            <!-- Call 112 button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_call_112"
                style="@style/Widget.Jaagruth.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="12dp"
                android:text="@string/btn_call_112"
                app:icon="@drawable/ic_call"
                app:iconGravity="textStart"
                app:iconTint="@color/primary_red" />

            <!-- I am safe / cancel request -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_im_safe"
                style="@style/Widget.Jaagruth.Button.Cancel"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="12dp"
                android:text="@string/btn_im_safe"
                android:textColor="@color/crimson" />
        </LinearLayout>

        <!-- Timeline Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_timeline"
            style="@style/Widget.Jaagruth.Card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_action_buttons">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Incident Timeline"
                    android:textColor="@color/heading"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_incident_timeline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Location sharing note footer -->
        <TextView
            android:id="@+id/tv_location_note_footer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="24dp"
            android:fontFamily="@font/plus_jakarta_sans"
            android:gravity="center"
            android:text="@string/location_sharing_stops_note"
            android:textColor="@color/secondary_text"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_timeline" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
